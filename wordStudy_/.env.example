# 실제 .env는 커밋하지 않습니다. 기존 DB 사용 시 암호를 변경하지 마세요.
WORDSTUDY_DB_PASSWORD=여기에_기존_DB_암호
WORDSTUDY_PORT=43871
ENABLE_IMPORT=0
PUBLIC_ORIGIN=http://localhost:43871
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=32자_이상의_무작위_값
# 선택적 TTS: 아래 값을 설정하고 --profile tts로 시작합니다.
TTS_URL=
TTS_MODEL_REVISION=piper-1.3.0-ljspeech-medium-e9ab671f2a0e50a701b34361136ba3e6a3a9eb0c
