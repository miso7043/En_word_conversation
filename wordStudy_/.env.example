# 실제 .env는 커밋하지 않습니다. 기존 DB 사용 시 암호를 변경하지 마세요.
WORDSTUDY_DB_PASSWORD=여기에_기존_DB_암호
WORDSTUDY_PORT=43871
ENABLE_IMPORT=0
PUBLIC_ORIGIN=http://localhost:43871
# 도메인 하위 경로 배포 시 /enWordStudy, 루트 배포 시 빈 값
APP_BASE_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=32자_이상의_무작위_값

ADMIN_USERNAME=
# 평문 비밀번호 대신 scrypt salt:hash 값만 설정합니다.
ADMIN_PASSWORD_HASH=
