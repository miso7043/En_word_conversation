{
  "name": "wordstudy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-transform-types server/index.ts",
    "verify": "node scripts/verify-playback.mjs && node scripts/verify-playlist.mjs && node --experimental-transform-types scripts/verify-learning.mjs && node --experimental-transform-types scripts/verify-auth.mjs",
    "verify:api": "node scripts/verify-api.mjs"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "24.10.4",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
